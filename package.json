{
  "name": "rak-madness-calculator",
  "productName": "The Rakulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "Cullen Rombach",
    "email": "cullenrombach@gmail.com"
  },
  "scripts": {
    "start": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run --mode test",
    "pages:dev": "npm run build && wrangler pages dev ./build --port 3000",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "prettier": "npx prettier . --check",
    "prettier:fix": "npm run prettier -- --write",
    "format": "npm run lint:fix && npm run prettier:fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/dseg14-classic": "^5.3.0",
    "@fontsource/dseg7-classic": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lodash.throttle": "^4.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "sass": "^1.103.1",
    "uuid": "^14.0.2",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
